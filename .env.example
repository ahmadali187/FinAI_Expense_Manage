# Example Environment Variables Template
# Copy this file to .env and fill in your real credentials:
REACT_APP_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
PORT=3001
JWT_SECRET=your_secure_random_jwt_secret_here

# API Base URL (For Render: https://finai-expense-manage.onrender.com/api)
REACT_APP_API_URL=http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api

